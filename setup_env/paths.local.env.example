# Copiar a setup_env/paths.local.env (no se versiona) y ajustar.
export PROJECT_ROOT=$HOME/RTDETR_TRACK_2
export DATA_ROOT=$HOME/data            # DanceTrack, CrowdHuman, COCO convertido, smoke_coco
export CKPT_DIR=$HOME/checkpoints      # checkpoints preentrenados
export OUTPUT_ROOT=$HOME/outputs       # salidas de entrenamiento / inferencia
export SEED=42
export CONDA_ENV=rtdetr_track
export DANCETRACK_DIR=$DATA_ROOT/dancetrack   # carpeta con train1/ train2/ val/
